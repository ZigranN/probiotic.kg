generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ПОЛЬЗОВАТЕЛИ И РОЛИ
// ==========================================

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  firstName     String?
  lastName      String?
  phone         String?   @unique
  email         String?   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)

  orders    Order[]
  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  reviews   Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// NEXTAUTH
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// АДРЕСА
// ==========================================

model Address {
  id     String @id @default(uuid())
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String?
  city      String
  street    String
  building  String
  apartment String?
  entrance  String?
  floor     String?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==========================================
// КАТАЛОГ
// ==========================================

enum Category {
  PROBIOTIC
  CANDLES
  ACTIVES
}

model Product {
  id       String   @id @default(uuid())
  slug     String   @unique
  name     String
  category Category

  // ------------------------------------------
  // ОСНОВНЫЕ ДАННЫЕ
  // ------------------------------------------

  heroTag     String?
  subtitle    String?
  form        String?
  packInfo    String?
  description String  @db.Text

  // ------------------------------------------
  // КОНТЕНТ КАРТОЧКИ
  // ------------------------------------------

  composition String? @db.Text
  dosageNote  String? @db.Text

  shortBenefits Json
  forWhom       Json?
  keyNotes      Json?
  features      Json?
  howToUse      Json?
  cautions      Json?
  storage       Json?

  // ------------------------------------------
  // UI / FAQ
  // ------------------------------------------

  badges Json?
  tags   Json?
  faq    Json?

  // ------------------------------------------
  // ИЗОБРАЖЕНИЯ
  // ------------------------------------------

  images  Json
  imageBg String?

  // ------------------------------------------
  // ЦЕНЫ И НАЛИЧИЕ
  // ------------------------------------------

  oldPriceKgs Int?
  priceKgs    Int

  inStock Boolean @default(true)

  // ------------------------------------------
  // ВАРИАНТЫ
  // ------------------------------------------

  variants Json?

  // ------------------------------------------
  // СВЯЗАННЫЕ ТОВАРЫ
  // ------------------------------------------

  relatedSlugs Json?

  // ------------------------------------------
  // SEO
  // ------------------------------------------

  seoTitle       String?
  seoDescription String? @db.Text

  // ------------------------------------------
  // RELATIONS
  // ------------------------------------------

  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([inStock])
}

// ==========================================
// ОТЗЫВЫ
// ==========================================

model Review {
  id        String @id @default(uuid())
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  name   String
  rating Int
  text   String @db.Text

  images Json?

  isApproved Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([isApproved])
}

// ==========================================
// ЗАКАЗЫ
// ==========================================

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            String  @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String?

  status     OrderStatus @default(PENDING)
  totalPrice Float

  // ------------------------------------------
  // ДОСТАВКА
  // ------------------------------------------

  city          String?
  street        String?
  building      String?
  apartment     String?
  deliveryNotes String?

  // ------------------------------------------
  // ОПЛАТА
  // ------------------------------------------

  paymentDetails String? @db.Text

  // ------------------------------------------
  // RELATIONS
  // ------------------------------------------

  items OrderItem[]

  userId String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// ПОЗИЦИИ ЗАКАЗА
// ==========================================

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productSlug String

  product Product @relation(fields: [productSlug], references: [slug], onUpdate: Cascade, onDelete: Restrict)

  // Snapshot товара на момент покупки
  name     String
  price    Float
  quantity Int

  @@index([orderId])
  @@index([productSlug])
}

// ==========================================
// ЗАЯВКИ НА ПАРТНЕРСТВО
// ==========================================

model PartnershipLead {
  id    String  @id @default(uuid())
  name  String
  phone String
  email String?

  desiredPackage String?

  isProcessed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([isProcessed])
  @@index([createdAt])
}

// ==========================================
// БЛОГ / БАЗА ЗНАНИЙ
// ==========================================

model Article {
  id    String @id @default(uuid())
  slug  String @unique
  title String

  topic String

  content String @db.Text

  youtubeUrl String?
  imageUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
  @@index([createdAt])
}
